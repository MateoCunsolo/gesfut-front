# Plantilla de la imagen oficial nginx: /etc/nginx/templates/default.conf.template
# BACKEND_URL es el origen del back, sin path (ej. http://gesfut-back:8080).
# En Easypanel los servicios se llaman db, back y front: hay que setear BACKEND_URL
# (ej. http://back:8080). El default http://gesfut-back:8080 no va a resolver ahi.
# Se sustituye en runtime; no hay secretos aca. No cambiar el default de la imagen aca.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # Easypanel/Docker: resolver el back en runtime por si el servicio no esta al arrancar nginx.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # realip: Traefik/Easypanel estan adelante. CIDRs privadas fijas + REAL_IP_FROM extra (env, sin secretos).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from ${REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location ^~ /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        set $gesfut_backend "${BACKEND_URL}";
        proxy_pass $gesfut_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /api {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        set $gesfut_backend "${BACKEND_URL}";
        proxy_pass $gesfut_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location = /ngsw.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location ~* "^/(ngsw-worker|safety-worker|worker-basic).*\.js$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location ~* "-[A-Za-z0-9]{8,}\.(js|mjs|css|woff2?|ttf|png|jpe?g|webp|svg|ico)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
