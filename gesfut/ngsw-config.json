{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "gesfut-app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.ico", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/*.png", "/**/*.woff2"]
      }
    },
    {
      "name": "gesfut-images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/**/*.(svg|png|jpg|jpeg|webp|ico)"] }
    }
  ],
  "dataGroups": [],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/__*", "!/**/__*/*", "!/api/**"]
}
